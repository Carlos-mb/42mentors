# Copia este fichero como .env y rellena los valores. NUNCA subas .env a git.

# App OAuth de la intra (https://profile.intra.42.fr/oauth/applications)
FT_CLIENT_ID=tu_uid
FT_CLIENT_SECRET=tu_secret
# Debe coincidir EXACTAMENTE con una Redirect URI registrada en la app
FT_REDIRECT_URI=https://42.2275676.xyz/callback.php

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nombre_bd
DB_USER=usuario_bd
DB_PASS=contraseña_bd

# Logins de los administradores (separados por comas): ven admin.php y pueden quitar la marca de mentor oficial o manguito
ADMIN_LOGINS=tu_login

# Códigos de los enlaces privados con los que alguien se declara mentor oficial (mentor-manguito.php) o manguito
# (soy-manguito.php). Sin código, la página responde 404. Genera uno distinto para cada una: openssl rand -hex 16
# El enlace se manda así: https://<dominio>/mentor-manguito.php?c=<código>. Si se filtra, cambia el código.
MENTOR_INVITE_CODE=
MANGUITO_INVITE_CODE=

# Provisional: True = todo el mundo cuenta como manguito y ve «Disponibles ahora», se haya marcado o no
MANGUITOS_ALL=False

# Sistema de valoraciones «Me ayudó»: False (o 0, no, off) lo oculta y bloquea; los votos guardados se conservan
VOTES_ENABLED=True

# Segundos que se cachean las ubicaciones del cluster (límite API: 2 req/s, 1200 req/h)
LOCATIONS_CACHE_TTL=120
# Segundos que se cachean nombre, foto, nivel y coalición de los mentores
PROFILES_CACHE_TTL=3600

# 1 = mostrar errores PHP (solo en local)
APP_DEBUG=0
